# next.config.ts의 rewrites()가 프록시할 백엔드 마이크로서비스 주소.
# 값을 지정하지 않으면 로컬 개발용 기본값(localhost:PORT)을 사용한다.
# 스테이징/프로덕션 빌드에서는 반드시 실제 서비스 주소로 설정해야 한다.

API_SERVICE_URL=http://localhost:8080
RESERVATION_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
REVIEW_SERVICE_URL=http://localhost:8084
